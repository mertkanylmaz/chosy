{
  "cli": {
    "version": ">= 10.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development",
      "ios": {
        "simulator": true,
        "image": "latest"
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_ENV": "development"
      }
    },
    "development:device": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development",
      "ios": {
        "simulator": false,
        "image": "latest"
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_ENV": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "ios": {
        "simulator": false
      },
      "env": {
        "APP_ENV": "preview"
      }
    },
    "preview-store": {
      "extends": "preview",
      "distribution": "store"
    },
    "preview-e2e": {
      "extends": "preview-store",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "e2e-test"
      },
      "autoIncrement": false
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "environment": "production",
      "env": {
        "APP_ENV": "production"
      }
    }
  },
  "submit": {
    "preview": {
      "ios": {
        "appleId": "mertkanylmaz@gmail.com",
        "ascAppId": "6761782987",
        "appleTeamId": "4CG256GKHM"
      }
    },
    "preview-store": {
      "ios": {
        "appleId": "mertkanylmaz@gmail.com",
        "ascAppId": "6761782987",
        "appleTeamId": "4CG256GKHM"
      }
    },
    "preview-e2e": {
      "ios": {
        "appleId": "mertkanylmaz@gmail.com",
        "ascAppId": "6761782987",
        "appleTeamId": "4CG256GKHM"
      }
    },
    "production": {
      "ios": {
        "appleId": "mertkanylmaz@gmail.com",
        "ascAppId": "6761782987",
        "appleTeamId": "4CG256GKHM"
      },
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "internal"
      }
    }
  }
}
