{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "supabase/functions",
    "tests/config",
    "tests/game-system",
    "tests/games",
    "tests/identity",
    "tests/net",
    "tests/gauntlet",
    "tests/profile",
    "tests/subscription",
    "components/paywalls/_archive"
  ]
}
