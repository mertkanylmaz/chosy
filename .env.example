# ─── Client-side (Expo) ─────────────────────────────────────────────────────
# Bu değişkenler bundle'a dahil olur — hassas bilgi YAZMA
#
# UYARI: `.env` .gitignore'da, yani EAS build arşivine GİRMEZ. Buradaki her
# EXPO_PUBLIC_* değişkeni ayrıca EAS ortamına da yazılmalı:
#   npx eas env:create --environment production --name <AD> --value <deger>
# Doğrulama: npm run check:env (yerel) · npm run check:env:eas (EAS production)

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# TMDb — client tarafı (film detay + watch providers, services/tmdb.ts)
# scripts/ altındaki araçlar TMDB_API_KEY adını da kabul eder (aşağıda)
EXPO_PUBLIC_TMDB_API_KEY=your-tmdb-api-key

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Google Cloud Console > APIs & Services > Credentials
# Web client ID → Supabase Google provider ile eşleşmeli
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
# iOS client ID → app.json iosUrlScheme ile eşleşmeli
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id.apps.googleusercontent.com

# ─── RevenueCat ──────────────────────────────────────────────────────────────
# RevenueCat Dashboard > Project > API Keys
EXPO_PUBLIC_RC_IOS_KEY=your-revenuecat-ios-api-key
# Opsiyonel — Android store'a submit edilene kadar zorunlu değil
EXPO_PUBLIC_RC_ANDROID_KEY=your-revenuecat-android-api-key

# ─── Sentry ──────────────────────────────────────────────────────────────────
# DSN client tarafında okunur (app/_layout.tsx Sentry.init).
# BOŞSA SDK hiçbir event göndermez — captureException/captureMessage no-op olur.
# Sentry Dashboard > Settings > Client Keys (DSN)
EXPO_PUBLIC_SENTRY_DSN=https://your-key@oXXXX.ingest.sentry.io/XXXX

# ─── PostHog Analytics ────────────────────────────────────────────────────────
# PostHog Dashboard > Project > Settings > Project API Key
# İkisinden biri boşsa services/posthog.ts init'i atlar — analitik kapalı olur
EXPO_PUBLIC_POSTHOG_KEY=phc_your-posthog-project-key
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ─── Backend-only (Supabase Edge Functions + scripts/) ───────────────────────
# Bu değişkenler ASLA EXPO_PUBLIC_ prefix'i almamalı — client'a açılmamalı

# scripts/ araçları için (fetch-films, enrich-*, backfill-* ...)
TMDB_API_KEY=your-tmdb-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Edge Function runtime'inin enjekte ettigi deger. requireServiceRole()
# bunu bekler. 9 Agu 2026da canli dogrulandi (400 FORCE_WITHOUT_DATE).
# Vault 'cron_service_role_key' bu degerle ayni olmali.
SUPABASE_SECRET_KEY=sb_secret_...

# UYARI: bu deger Edge kapisini ACMIYOR (401, 9 Agu 2026 olcumu).
# Adi yaniltici. Kaynagi Dashboard'dan teyit edilene kadar KULLANMA.
# scripts/ altındaki 14 araç bu adı okur.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── EAS Build ───────────────────────────────────────────────────────────────
# Sourcemap upload — yalnızca EAS builder'da gerekli (EAS secret olarak tanımlı)
SENTRY_AUTH_TOKEN=
EAS_PROJECT_ID=your-eas-project-id
