{
  "name": "moodflix",
  "main": "expo-router/entry",
  "version": "1.1.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "typecheck:functions": "cd supabase/functions && deno check **/index.ts",
    "fetch:films": "tsx scripts/fetch-films.ts",
    "enrich:imdb": "tsx scripts/enrich-imdb-ratings.ts",
    "enrich:metadata": "tsx scripts/enrich-films-metadata.ts",
    "profile-films": "tsx scripts/profile-films.ts",
    "seed-database": "tsx scripts/seed-database.ts",
    "seed:films": "tsx scripts/seed-films-to-db.ts",
    "db:verify": "tsx scripts/verify-db-state.ts",
    "db:tier-stats": "tsx scripts/verify-db-state.ts",
    "build:dev": "eas build --profile development --platform all",
    "build:preview": "eas build --profile preview --platform all",
    "build:ios": "eas build --profile production --platform ios",
    "build:android": "eas build --profile production --platform android",
    "submit:ios": "eas submit --profile production --platform ios",
    "submit:android": "eas submit --profile production --platform android",
    "release:ios": "eas build --profile production --platform ios --auto-submit",
    "release:android": "eas build --profile production --platform android --auto-submit",
    "process:figurler": "python3 scripts/remove_white_backgrounds.py",
    "test:quality": "tsx tests/recommendation-quality/run-quality-test.ts",
    "quality:adversarial": "tsx tests/recommendation-quality/adversarial-runner.ts",
    "test:founder": "tsx tests/founder-acceptance/runner.ts",
    "profile:ai": "tsx scripts/ai-profile-films.ts",
    "profile:ai:missing": "tsx scripts/ai-profile-films.ts --only-missing",
    "profile:ai:verify": "tsx scripts/verify-ai-profiles.ts",
    "sentry:sourcemaps": "npx sentry-expo-upload-sourcemaps dist",
    "lint:config": "tsx scripts/lint-remote-config.ts",
    "lint:ui": "tsx scripts/lint-optimistic-ui.ts",
    "lint:all": "tsx scripts/lint-remote-config.ts && tsx scripts/lint-optimistic-ui.ts",
    "lint": "expo lint"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@expo-google-fonts/playfair-display": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-navigation/bottom-tabs": "^7.10.1",
    "@react-navigation/native": "^7.1.28",
    "@sentry/react-native": "~7.2.0",
    "@supabase/supabase-js": "^2.98.0",
    "expo": "^54.0.34",
    "expo-apple-authentication": "~8.0.8",
    "expo-blur": "~15.0.8",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-localization": "~17.0.8",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.23",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-store-review": "~9.0.9",
    "expo-symbols": "~1.0.8",
    "expo-updates": "~29.0.17",
    "expo-web-browser": "~15.0.11",
    "i18n-js": "^4.5.3",
    "openai": "^6.39.0",
    "phosphor-react-native": "^3.0.6",
    "posthog-react-native": "^4.45.15",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-purchases": "^10.0.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-view-shot": "4.0.3",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "react-native-youtube-iframe": "^2.4.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.1.10",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~10.0.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
