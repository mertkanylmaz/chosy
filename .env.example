# ─── Client-side (Expo) ─────────────────────────────────────────────────────
# Bu değişkenler bundle'a dahil olur — hassas bilgi YAZMA

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Google Cloud Console > APIs & Services > Credentials
# Web client ID → Supabase Google provider ile eşleşmeli
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
# iOS client ID → app.json iosUrlScheme ile eşleşmeli
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id.apps.googleusercontent.com

# ─── RevenueCat ──────────────────────────────────────────────────────────────
# RevenueCat Dashboard > Project > API Keys
EXPO_PUBLIC_RC_IOS_KEY=your-revenuecat-ios-api-key
EXPO_PUBLIC_RC_ANDROID_KEY=your-revenuecat-android-api-key

# ─── Backend-only (Supabase Edge Functions) ──────────────────────────────────
# Bu değişkenler ASLA EXPO_PUBLIC_ prefix'i almamalı — client'a açılmamalı
# Supabase Dashboard > Project Settings > Edge Functions > Secrets'a ekle

TMDB_API_KEY=your-tmdb-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── EAS Build ───────────────────────────────────────────────────────────────

EAS_PROJECT_ID=your-eas-project-id
